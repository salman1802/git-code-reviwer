# Git Code Reviewer - API Keys
# Set the key for your chosen provider. Only one is required.

# OpenAI (default provider)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Optional: Custom API base URL (for proxies or local LLMs like Ollama)
# OPENAI_BASE_URL=http://localhost:11434/v1
